<%- include('includes/head')%>

<%- include('includes/navbar')%>

<div class="container">
  <div class="row">
    <div class="col-lg-2">

    </div>
    <div class="col-lg-8 my-3">
      <h1 class="text-center">Entre ou Crie Sua Conta!</h1>
      <p class="text-center lead">Seu Campo de acesso abaixo!</p>

      <div class="row">

          <div class="col-lg my-3">
            <h4>Faça seu login</h4>
            <p>Se você já possui uma conta, faça login abaixo:</p>

            <%- include('includes/messages')%>

            <form class="form-login" action="/login/login" method="POST">
              <input type="hidden" name="_csrf" value="<%- csrfToken %>">
              <div class="mb-3">
                <label class="form-label">Seu e-mail</label>
                <input type="email" class="form-control" name="email">
              </div>
              <div class="mb-3">
                <label class="form-label">Sua senha</label>
                <input type="password" class="form-control" name="password">
              </div>
              <button type="submit" class="btn btn-primary">Entrar</button>
            </form>
          </div>

          <div class="col-lg my-3">
            <h4>Faça seu cadastro</h4>
            <p>Se você não possui uma conta, cadastre-se abaixo:</p>

            <form class="form-cadastro" action="/login/register" method="POST">
              <input type="hidden" name="_csrf" value="<%- csrfToken %>">
              <div class="mb-3">
                <label class="form-label">Seu e-mail</label>
                <input type="email" class="form-control" name="email">
              </div>
              <div class="mb-3">
                <label class="form-label">Sua senha</label>
                <input type="password" class="form-control" name="password">
              </div>
              <button type="submit" class="btn btn-primary">Criar minha conta</button>
            </form>
          </div>
      </div>
      
    </div>
    <div class="col-lg-2">
      
    </div>
  </div>

</div>

<%- include('includes/footer')%>
