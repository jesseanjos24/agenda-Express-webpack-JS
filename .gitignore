# ==========================================
# SEGURANÇA & DADOS SENSÍVEIS (CRÍTICO)
# ==========================================
# Arquivos com senhas, credenciais e strings de conexão
.env
.env.*
*.env
atlas-credentials.env
guia.txt

# Certificados, chaves privadas e credenciais
*.pem
*.key
*.cert
*.crt
credentials.json

# Permitir explicitamente o arquivo de exemplo
!.env.example

# ==========================================
# DEPENDÊNCIAS
# ==========================================
node_modules/
jspm_packages/

# ==========================================
# LOGS
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# BUILD & ARQUIVOS GERADOS (WEBPACK)
# ==========================================
# Source maps pesados de compilação
*.map
public/assets/js/bundle.js.map

# Caso queira que o bundle compilado também não vá para o repositório,
# descomente a linha abaixo:
# public/assets/js/bundle.js

# ==========================================
# SISTEMA OPERACIONAL (WINDOWS / MAC / LINUX)
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ==========================================
# EDITORES DE CÓDIGO & IDES
# ==========================================
.vscode/
.idea/
*.swp
*.swo
